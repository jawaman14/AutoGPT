# Spotify credentials — create an app at https://developer.spotify.com/dashboard
# and add the redirect URI below to it.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Optional: path to a ytmusicapi auth file (browser.json/oauth.json), only
# needed for reading PRIVATE YouTube Music playlists. Public playlists need
# no authentication at all.
YTMUSIC_AUTH_FILE=
